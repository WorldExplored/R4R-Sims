ninja_required_version = 1.3
cxx = /usr/bin/g++-11
nvcc = /workspace/R4R-Sims/artifacts/traveluav-openuav/dependencies/cuda-11.8/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=gsplat_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/TH -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/THC -isystem /workspace/R4R-Sims/artifacts/traveluav-openuav/dependencies/cuda-11.8/include -isystem /usr/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -ccbin /usr/bin/gcc-11 -DTORCH_EXTENSION_NAME=gsplat_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/TH -isystem /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/include/THC -isystem /workspace/R4R-Sims/artifacts/traveluav-openuav/dependencies/cuda-11.8/include -isystem /usr/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/workspace/R4R-Sims/artifacts/traveluav-openuav/dependencies/cuda-11.8/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build sh.cuda.o: cuda_compile /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc/sh.cu
build projection.cuda.o: cuda_compile /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc/projection.cu
build rasterization.cuda.o: cuda_compile /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc/rasterization.cu
build ext.o: compile /home/ubuntu/grad-nav-deps/env-render/lib/python3.10/site-packages/gsplat/cuda/csrc/ext.cpp



build gsplat_cuda.so: link sh.cuda.o projection.cuda.o rasterization.cuda.o ext.o

default gsplat_cuda.so
